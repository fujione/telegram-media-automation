#!/usr/bin/env python3
"""OpenClaw helper for Telegram Media Automation tasks and subscriptions."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import urlencode


def settings() -> tuple[str, str]:
    values = {
        "TELEGRAM_MEDIA_API_URL": os.environ.get("TELEGRAM_MEDIA_API_URL", ""),
        "TELEGRAM_MEDIA_API_TOKEN": os.environ.get("TELEGRAM_MEDIA_API_TOKEN", ""),
    }
    config = Path(os.environ.get("TELEGRAM_MEDIA_API_CONFIG", Path(__file__).with_name("api.env")))
    if config.is_file():
        for raw in config.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            if key in values and not values[key]:
                values[key] = value.strip()
    return values["TELEGRAM_MEDIA_API_URL"].rstrip("/"), values["TELEGRAM_MEDIA_API_TOKEN"]


BASE_URL, TOKEN = settings()


def call(
    path: str, method: str = "GET", body: object | None = None, timeout: int = 30
) -> tuple[int, object]:
    if not BASE_URL or not TOKEN:
        raise SystemExit(
            "TELEGRAM_MEDIA_API_URL and TELEGRAM_MEDIA_API_TOKEN must be configured privately"
        )
    data = json.dumps(body, ensure_ascii=False).encode() if body is not None else None
    req = urllib.request.Request(
        BASE_URL + path,
        data=data,
        headers={"Authorization": f"Bearer {TOKEN}", "Content-Type": "application/json"},
        method=method,
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:  # nosec B310
            return response.status, json.loads(response.read() or b"null")
    except urllib.error.HTTPError as error:
        try:
            payload = json.loads(error.read() or b"null")
        except json.JSONDecodeError:
            payload = {"error": error.reason}
        return error.code, payload
    except urllib.error.URLError as error:
        raise SystemExit(f"Telegram Media Automation 不可达: {error.reason}") from error


def finish(status: int, payload: object) -> None:
    print(json.dumps(payload, ensure_ascii=False))
    if not 200 <= status < 300:
        raise SystemExit(1)


def json_arg(index: int) -> object:
    try:
        return json.loads(sys.argv[index])
    except (IndexError, json.JSONDecodeError) as error:
        raise SystemExit("JSON 参数无效") from error


def attach_resources(status: int, payload: object) -> tuple[int, object]:
    if not 200 <= status < 300:
        return status, payload
    tasks = payload if isinstance(payload, list) else [payload]
    for task in tasks:
        if not isinstance(task, dict) or "resource_id" not in task:
            continue
        resource_status, resource = call(f"/api/v1/resources/{task['resource_id']}")
        if 200 <= resource_status < 300:
            task["resource"] = resource
    return status, payload


def main() -> None:
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "search" and len(sys.argv) == 3:
        finish(*call("/api/v1/searches", "POST", json_arg(2)))
    elif action == "download" and len(sys.argv) == 3:
        finish(*call("/api/v1/tasks", "POST", json_arg(2)))
    elif action == "replace" and len(sys.argv) == 4:
        finish(*call(f"/api/v1/tasks/{sys.argv[2]}/replace", "POST", json_arg(3), timeout=900))
    elif action == "replacement-plan" and len(sys.argv) == 4:
        finish(*call(f"/api/v1/tasks/{sys.argv[2]}/replacement-plan", "POST", json_arg(3)))
    elif action == "import" and len(sys.argv) == 4:
        finish(*call(f"/api/v1/tasks/{sys.argv[2]}/import", "POST", json_arg(3), timeout=900))
    elif action == "library" and len(sys.argv) in (3, 4):
        query = urlencode(
            {"query": sys.argv[2], "kind": sys.argv[3] if len(sys.argv) == 4 else "series"}
        )
        finish(*call(f"/api/v1/library/files?{query}"))
    elif action == "subscribe" and len(sys.argv) == 3:
        finish(*call("/api/v1/subscriptions", "POST", json_arg(2)))
    elif action == "subscriptions" and len(sys.argv) == 2:
        finish(*call("/api/v1/subscriptions"))
    elif (
        action in {"subscription-pause", "subscription-resume", "subscription-remove"}
        and len(sys.argv) == 3
    ):
        sid = sys.argv[2]
        if action == "subscription-remove":
            finish(*call(f"/api/v1/subscriptions/{sid}", "DELETE"))
        else:
            finish(
                *call(f"/api/v1/subscriptions/{sid}/{action.removeprefix('subscription-')}", "POST")
            )
    elif action == "summary" and len(sys.argv) == 2:
        finish(*call("/api/v1/tasks/summary"))
    elif action == "tasks" and len(sys.argv) <= 3:
        limit = sys.argv[2] if len(sys.argv) == 3 else "100"
        finish(*attach_resources(*call(f"/api/v1/tasks?limit={limit}")))
    elif action == "task" and len(sys.argv) == 3:
        finish(*attach_resources(*call(f"/api/v1/tasks/{sys.argv[2]}")))
    elif action == "events" and len(sys.argv) == 3:
        finish(*call(f"/api/v1/tasks/{sys.argv[2]}/events"))
    elif action in {"pause", "resume", "cancel", "retry"} and len(sys.argv) in (3, 4):
        body = {"reason": sys.argv[3]} if len(sys.argv) == 4 else {}
        finish(*call(f"/api/v1/tasks/{sys.argv[2]}/{action}", "POST", body))
    else:
        raise SystemExit(
            "usage: search|download|subscribe '<json>' | "
            "import|replace|replacement-plan <task-id> '<json>' | "
            "library <query> [movie|series] | subscriptions | "
            "subscription-pause|subscription-resume|subscription-remove <id> | "
            "summary | tasks [limit] | task|events <id> | "
            "pause|resume|cancel|retry <id> [reason]"
        )


if __name__ == "__main__":
    main()
