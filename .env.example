# Advanced deployment reference. Prefer `mediactl init --docker` so administrator credentials
# and writable host directories are created and validated before Compose starts.
APP_ENVIRONMENT=production
APP_LANGUAGE=zh-CN
APP_TIMEZONE=Asia/Shanghai
APP_ARCHIVE_MODE=move
APP_CLEANUP_ENABLED=true
APP_CLEANUP_INTERVAL_SECONDS=3600
APP_CLEANUP_RETENTION_SECONDS=86400
TMA_HOST_DATA_DIR=./data
TMA_HOST_BACKUP_DIR=./data/backups
TMA_HOST_INCOMPLETE_DIR=./downloads/incomplete
TMA_HOST_INBOX_DIR=./downloads/inbox
TMA_HOST_MOVIE_DIR=./media/movies
TMA_HOST_TV_DIR=./media/tv
# Keep 127.0.0.1 for a reverse proxy on the same host. Use 0.0.0.0 only when the
# password-protected Web UI must be reachable directly from a trusted LAN.
TMA_BIND_ADDRESS=127.0.0.1
TMA_HOST_PORT=8080
# Linux/NAS: use the owner of the mounted directories (`id -u` and `id -g`).
# The default matches the non-root account built into the image.
TMA_UID=10001
TMA_GID=10001
# Override only when Docker Hub is unavailable. AWS Public ECR mirrors Docker Official Images.
# TMA_PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
# TMA_UV_IMAGE=ghcr.io/astral-sh/uv:0.12.5
APP_DATA_DIR=/data
APP_DATABASE_URL=sqlite:////data/media_automation.sqlite3
APP_BACKUP_DIR=/backups
APP_DOWNLOAD_INCOMPLETE=/downloads/incomplete
APP_DOWNLOAD_INBOX=/downloads/inbox
APP_MOVIE_ROOT=/media/movies
APP_TV_ROOT=/media/tv
# Replace these three values before first start. This copied .env file is Git-ignored.
APP_API_TOKEN=replace-with-a-long-random-token
APP_TELEGRAM_API_ID=123456
APP_TELEGRAM_API_HASH=replace-with-your-api-hash
# Production alternative: comment the direct values above and use secret files.
# APP_API_TOKEN_FILE=/run/secrets/api_token
# APP_ADMIN_CREDENTIALS_FILE=/run/secrets/admin_credentials.json
# APP_TELEGRAM_API_ID_FILE=/run/secrets/telegram_api_id
# APP_TELEGRAM_API_HASH_FILE=/run/secrets/telegram_api_hash
APP_TELEGRAM_SESSION=/data/sessions/telegram.session
APP_WEB_SESSION_LIFETIME_SECONDS=43200
APP_TELEGRAM_CONNECT_TIMEOUT=8
APP_TELEGRAM_CONNECTION_RETRIES=1
APP_TELEGRAM_OPERATION_TIMEOUT=20
APP_QUALITY_PREFERRED_RESOLUTIONS='[2160,1080,720]'
APP_QUALITY_ALLOWED_RESOLUTIONS='[]'
APP_QUALITY_PREFERRED_LANGUAGES='["zh","en"]'
APP_QUALITY_ALLOWED_LANGUAGES='[]'
APP_QUALITY_PREFER_HDR=false
# Optional hard size ceiling in bytes.
# APP_QUALITY_MAX_FILE_SIZE=21474836480
# Optional proxy secret containing socks5://user:pass@host:port, socks4:// or http://.
# APP_TELEGRAM_PROXY_URL=socks5://user:pass@proxy.example:1080
# APP_TELEGRAM_PROXY_URL_FILE=/run/secrets/telegram_proxy_url
APP_TELEGRAM_SEARCH_CHANNELS='["channel_username", "-1001234567890"]'
APP_WORKER_POLL_INTERVAL=2
APP_WORKER_MAX_ATTEMPTS=5
APP_WORKER_RETRY_DELAY=30
APP_WORKER_LEASE_SECONDS=60
APP_SUBSCRIPTION_POLL_INTERVAL=300
APP_WORKERS_ENABLED=true
APP_MINIMUM_FREE_BYTES=1073741824
# Uncomment to set a positive byte/second download limit.
# APP_DOWNLOAD_BYTES_PER_SECOND=1048576
APP_DOWNLOAD_CHUNK_TIMEOUT=75
